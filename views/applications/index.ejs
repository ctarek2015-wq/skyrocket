<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Apps</title>
</head>

<%- include('../partials/_navbar.ejs') %>

<body>
  <h1>Your Apps</h1>
  <ul>
    <% applications.forEach((app)=>{%>
    <li>
      <a href="/users/<%=user._id%>/applications/<%=app._id%>">
        <%= app.title %> at <%= app.company %>
      </a>
    </li>

    <%})%>

  </ul>



  <a href="/users/<%=user._id%>/applications/new">add new app</a>
</body>

</html>